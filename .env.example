# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# AWS S3 Configuration (for uploading analysis results)
# Option 1: Standard AWS naming convention
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_PREFIX=MultiTechnique Alerts/telemetry/golden/

# Option 2: Legacy naming convention (backward compatible)
# BUCKET_NAME=your-s3-bucket-name
# ACCESS_KEY=your_aws_access_key_id
# SECRET_KEY=your_aws_secret_access_key

# Optional: Override default data paths
# SILVER_DATA_PATH=./data/telemetry/silver
# GOLDEN_DATA_PATH=./data/telemetry/golden
# CONFIG_PATH=./data/telemetry/config
